/q/*
  X-Robots-Tag: noindex, follow
  Cache-Control: public, max-age=300, must-revalidate

/api/visitor-context
  Cache-Control: private, no-store
  X-Content-Type-Options: nosniff

/api/events
  Cache-Control: private, no-store
  X-Content-Type-Options: nosniff

/go/amazon/*
  Cache-Control: private, no-store
  X-Content-Type-Options: nosniff
  X-Robots-Tag: noindex

/api/admin/analytics
  Cache-Control: private, no-store
  X-Content-Type-Options: nosniff
  X-Robots-Tag: noindex, nofollow

/admin/*
  Cache-Control: private, no-store
  X-Robots-Tag: noindex, nofollow
  X-Content-Type-Options: nosniff
